{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Prepare site for Go Live",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "--", "--watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "vite v.*building",
          "endsPattern": "built in .*"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
